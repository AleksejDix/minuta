---
/*
 * A month as a calendar grid, computed at build time with minuta's
 * `monthGrid`: 6 weeks of 7 days, days outside the month muted,
 * weekend days marked, one day optionally selected.
 */
import type { DatePeriod, Weekday } from "@aleksejdix/minuta";
import {
  contains,
  createUnits,
  period,
  same,
  toLocaleString,
  withUnits,
} from "@aleksejdix/minuta";
import { plainDate } from "./dates";

type Props = Readonly<{
  /** First day of a highlighted range, as `YYYY-MM-DD` */
  from?: string;
  /** Locale of the weekday names and the caption, default `en-US` */
  locale?: string;
  /** Days to mark with a dot, as `YYYY-MM-DD` */
  marks?: readonly string[];
  /** The month to show, as `YYYY-MM` */
  month: string;
  /** A day to mark as selected, as `YYYY-MM-DD` */
  selected?: string;
  /** Last day of a highlighted range, as `YYYY-MM-DD` */
  to?: string;
  /** First day of the week, default `monday` */
  weekStartsOn?: Weekday;
}>;

const DAYS_A_WEEK = 7;
const FIRST = 0;
const ONE = 1;

const {
  from,
  locale = "en-US",
  marks = [],
  month,
  selected,
  to,
  weekStartsOn = "monday",
} = Astro.props;

/**
 * The day a `YYYY-MM-DD` string names.
 *
 * @param iso - The day
 * @returns Its day period
 */
function dayOf(iso: string): DatePeriod {
  return period(plainDate(iso), "day");
}

/**
 * Whether a day lies in the highlighted range.
 *
 * @param day - A day of the grid
 * @returns True between `from` and `to`, both included
 */
function inRange(day: DatePeriod): boolean {
  if (from === undefined || to === undefined) {
    return false;
  }
  // From the first day to the last, both included: up to the day after `to`
  const span = { end: dayOf(to).end, start: dayOf(from).start, unit: "custom" } as const;
  return contains(span, day);
}

/**
 * Whether a day is one of the marked days.
 *
 * @param day - A day of the grid
 * @returns True for a day in `marks`
 */
function isMarked(day: DatePeriod): boolean {
  return marks.some((iso) => same(day, dayOf(iso), "day"));
}

const time = withUnits(createUnits({ weekStartsOn }));
const monthStart = plainDate(`${month}-01`);
const grid = time.monthGrid(monthStart);
const thisMonth = period(monthStart, "month");


/**
 * Whether a day is the selected one.
 *
 * @param day - A day of the grid
 * @returns True for the `selected` day
 */
function isSelected(day: DatePeriod): boolean {
  if (selected === undefined) {
    return false;
  }
  return same(day, dayOf(selected), "day");
}

const headers = grid.periods
  .slice(FIRST, DAYS_A_WEEK)
  .map((day) => toLocaleString(day, locale, { weekday: "short" }));
const weeks = Array.from(
  { length: grid.periods.length / DAYS_A_WEEK },
  (_unused, row) =>
    grid.periods
      .slice(row * DAYS_A_WEEK, (row + ONE) * DAYS_A_WEEK)
      .map((day) => ({
        inRange: inRange(day),
        label: day.start.day,
        marked: isMarked(day),
        outside: !contains(thisMonth, day.start),
        selected: isSelected(day),
        weekend: time.isWeekend(day),
      }))
);
---

<figure class="month-grid not-content">
  <figcaption>{toLocaleString(thisMonth, locale)}</figcaption>
  <table>
    <thead>
      <tr>{headers.map((name) => <th>{name}</th>)}</tr>
    </thead>
    <tbody>
      {
        weeks.map((days) => (
          <tr>
            {days.map((day) => (
              <td
                class:list={{
                  "is-in-range": day.inRange,
                  "is-marked": day.marked,
                  "is-outside": day.outside,
                  "is-selected": day.selected,
                  "is-weekend": day.weekend,
                }}
              >
                {day.label}
              </td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>
</figure>
