---
/*
 * The home page hero, in place of Starlight's: the headline, the actions
 * from the page's `hero` frontmatter and a live dial of today.
 */
import { LinkButton } from "@astrojs/starlight/components";
import { siteHref } from "./site-href";

const { hero } = Astro.locals.starlightRoute.entry.data;

/**
 * The hero's actions.
 *
 * @returns The actions, none when the page has no `hero`
 */
function heroActions(): NonNullable<typeof hero>["actions"] {
  if (hero === undefined) {
    return [];
  }
  return hero.actions;
}

/**
 * The hero's tagline.
 *
 * @returns The tagline, empty when the page has no `hero`
 */
function heroTagline(): string {
  if (hero === undefined || hero.tagline === undefined) {
    return "";
  }
  return hero.tagline;
}

const actions = heroActions();
const tagline = heroTagline();

---

<section class="almanac-hero not-content">
  <div class="almanac-hero__text">
    <p class="almanac-eyebrow">minuta · periods, calendars, date fields</p>
    <h1 class="almanac-title" id="_top">Divide time <em>into pieces.</em></h1>
    <p class="almanac-tagline">{tagline}</p>
    <div class="almanac-actions">
      {
        actions.map((action) => (
          <LinkButton
            href={siteHref(action.link)}
            icon={action.icon?.name}
            variant={action.variant}
          >
            {action.text}
          </LinkButton>
        ))
      }
    </div>
    <p class="almanac-install"><span>$</span> npm install minuta</p>
  </div>
  <div class="almanac-dial" data-dial></div>
</section>

<script>
  import { mountDials } from "./home/dial";

  mountDials();
</script>

<style is:global>
  .almanac-hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
    padding-block: clamp(2rem, 6vw, 5rem) clamp(2rem, 5vw, 4rem);
  }

  /*
   * The glow reaches past the hero's edge; clip it at the full-width panel,
   * i.e. the screen's edge, so the page never scrolls sideways
   */
  .content-panel:has(.almanac-hero) {
    overflow-x: clip;
  }

  .almanac-hero::before {
    content: "";
    position: absolute;
    inset: -10% -20% auto auto;
    width: 60%;
    aspect-ratio: 1;
    background: radial-gradient(
      circle,
      color-mix(in oklab, var(--sl-color-accent) 18%, transparent),
      transparent 65%
    );
    filter: blur(20px);
    pointer-events: none;
    z-index: -1;
  }

  .almanac-eyebrow {
    margin: 0 0 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--sl-color-accent);
  }

  .almanac-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(3.2rem, 1.6rem + 5.6vw, 6.2rem);
    line-height: 0.92;
    letter-spacing: -0.025em;
    color: var(--sl-color-white);
  }

  .almanac-title em {
    display: block;
    font-style: italic;
    color: var(--sl-color-accent);
  }

  .almanac-tagline {
    max-width: 34ch;
    margin: 1.5rem 0 2rem;
    font-size: clamp(1.05rem, 1rem + 0.3vw, 1.25rem);
    line-height: 1.55;
    color: var(--sl-color-gray-2);
  }

  .almanac-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .almanac-install {
    width: fit-content;
    margin: 1.75rem 0 0;
    padding: 0.55rem 0.9rem;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--sl-color-gray-2);
  }

  .almanac-install span {
    color: var(--sl-color-accent);
  }

  .almanac-dial {
    width: min(100%, 30rem);
    aspect-ratio: 1;
    justify-self: center;
    --dial-ink: var(--sl-color-white);
    --dial-faint: var(--sl-color-hairline-light);
  }

  .almanac-dial svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .almanac-dial path {
    fill: none;
    stroke-linecap: butt;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: almanac-draw 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
  }

  .almanac-dial.is-drawn path {
    animation: none;
    stroke-dashoffset: 0;
  }

  .almanac-dial .dial-month {
    stroke-width: 16;
    animation-delay: calc(var(--i) * 45ms);
  }

  .almanac-dial .dial-day {
    stroke-width: 11;
    animation-delay: calc(300ms + var(--i) * 14ms);
  }

  .almanac-dial .dial-hour {
    stroke-width: 9;
    animation-delay: calc(650ms + var(--i) * 18ms);
  }

  .almanac-dial .dial-past {
    stroke: var(--dial-ink);
    opacity: 0.82;
  }

  .almanac-dial .dial-future {
    stroke: var(--dial-faint);
  }

  .almanac-dial .dial-now {
    stroke: var(--sl-color-accent);
  }

  .almanac-dial .dial-label {
    font-family: var(--font-mono);
    font-size: 12px;
    fill: var(--sl-color-gray-3);
    text-anchor: middle;
    dominant-baseline: central;
  }

  .almanac-dial .dial-date {
    font-family: var(--font-display);
    font-size: 88px;
    fill: var(--dial-ink);
    text-anchor: middle;
  }

  .almanac-dial .dial-caption {
    font-family: var(--font-sans);
    font-size: 15px;
    letter-spacing: 0.06em;
    fill: var(--sl-color-gray-2);
    text-anchor: middle;
  }

  .almanac-dial .dial-time {
    font-family: var(--font-mono);
    font-size: 13px;
    fill: var(--sl-color-gray-3);
    text-anchor: middle;
  }

  .almanac-dial .dial-track {
    fill: none;
    stroke: var(--dial-faint);
    stroke-width: 1;
    stroke-dasharray: 2 4;
  }

  .almanac-dial .dial-hand {
    fill: var(--sl-color-accent);
    filter: drop-shadow(0 0 6px var(--sl-color-accent));
  }

  @keyframes almanac-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .almanac-dial path {
      animation: none;
      stroke-dashoffset: 0;
    }
  }

  @media (max-width: 50rem) {
    .almanac-hero {
      grid-template-columns: 1fr;
    }

    .almanac-dial {
      order: -1;
      width: min(100%, 22rem);
    }
  }
</style>
