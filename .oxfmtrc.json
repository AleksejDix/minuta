{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "trailingComma": "es5",
  "singleQuote": false,
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "arrowParens": "always",
  "endOfLine": "lf",
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules",
    "dist",
    "coverage",
    "*.min.js",
    "*.d.ts",
    "package-lock.json",
    "pnpm-lock.yaml",
    "yarn.lock",
    ".git",
    ".vscode",
    ".idea",
    "*.log",
    ".bmad-core",
    ".claude",
    ".gemini-tmp",
    "CHANGELOG.md",
    "docs/",
    "packages/minuta-vue/examples/playwright-report/",
    "packages/minuta-vue/examples/test-results/",
    "vitepress/"
  ]
}
