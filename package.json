{
  "name": "minuta-monorepo",
  "private": true,
  "type": "module",
  "description": "Minuta — divide time into pieces",
  "author": "Aleksej Dix <git@aleksejdix.com>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/AleksejDix/minuta",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AleksejDix/minuta.git"
  },
  "bugs": {
    "url": "https://github.com/AleksejDix/minuta/issues"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "lefthook install",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:workspaces": "npm run test --workspaces --if-present",
    "test:vue": "npm run build --workspace=minuta && TZ=UTC npm run test --workspace=minuta-vue",
    "dev": "npm run dev --workspace=minuta",
    "dev:react": "npm run dev --workspace=minuta-react",
    "dev:vue": "npm run dev --workspace=minuta-vue",
    "dev:inputs": "npm run build -w text-buffer -w input-state -w datefield -w input-dom && npm run dev --workspace=input-dom",
    "demo:build:react": "npm run demo:build --workspace=minuta-react",
    "demo:build:vue": "npm run demo:build --workspace=minuta-vue",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "knip": "knip",
    "lint:workspaces": "npm run lint --workspaces --if-present",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "type-check": "npm run type-check --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules",
    "release": "npm run build && changeset publish",
    "lint:packages": "for p in minuta minuta-react minuta-vue text-buffer input-state datefield input-dom fechita; do publint packages/$p || exit 1; done"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@vitest/coverage-v8": "^4.0.13",
    "jsdom": "^25.0.1",
    "knip": "^6.38.0",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2002",
    "publint": "^0.3.12",
    "vitest": "^4.0.13"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
