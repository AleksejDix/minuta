{
  "name": "@aleksejdix/minuta",
  "version": "1.0.0-beta.1",
  "type": "module",
  "description": "Divide time into pieces. Pure functional calendar library on Temporal.",
  "license": "Apache-2.0",
  "author": "Aleksej Dix <git@aleksejdix.com>",
  "homepage": "https://github.com/AleksejDix/minuta",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AleksejDix/minuta.git",
    "directory": "packages/minuta"
  },
  "bugs": {
    "url": "https://github.com/AleksejDix/minuta/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "@minuta/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "@minuta/source": "./src/core.ts",
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./calendar": {
      "@minuta/source": "./src/calendar.ts",
      "types": "./dist/calendar.d.ts",
      "import": "./dist/calendar.js"
    },
    "./intervals": {
      "@minuta/source": "./src/intervals.ts",
      "types": "./dist/intervals.d.ts",
      "import": "./dist/intervals.js"
    },
    "./format": {
      "@minuta/source": "./src/format.ts",
      "types": "./dist/format.d.ts",
      "import": "./dist/format.js"
    },
    "./temporal": {
      "@minuta/source": "./src/temporal.ts",
      "types": "./dist/temporal.d.ts",
      "import": "./dist/temporal.js"
    }
  },
  "imports": {
    "#src/*": {
      "source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./src/*.ts"
    },
    "#readme": "./README.md"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "llms.txt",
    "MIGRATION.md"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "type-check": "tsc -p tsconfig.check.json",
    "clean": "rm -rf dist node_modules",
    "size": "size-limit",
    "docs:llms": "cd ../.. && UPDATE_LLMS=1 vitest run --project minuta src/__tests__/docs/llms.test.ts",
    "prepack": "node -e \"require('node:fs').copyFileSync('../../LICENSE', 'LICENSE')\""
  },
  "size-limit": [
    {
      "name": "minuta: period + next + divide",
      "path": "dist/index.js",
      "import": "{ period, next, divide }",
      "limit": "5 kB"
    },
    {
      "name": "minuta: everything",
      "path": "dist/index.js",
      "import": "*",
      "limit": "5 kB"
    },
    {
      "name": "minuta/core: periodWith + nextWith with two units",
      "import": {
        "dist/core.js": "{ createUnits, periodWith, nextWith }"
      },
      "limit": "5 kB"
    },
    {
      "name": "minuta/calendar: monthGrid via bind",
      "import": {
        "dist/core.js": "{ bind, createUnits }",
        "dist/calendar.js": "{ calendar }"
      },
      "limit": "5 kB"
    },
    {
      "name": "minuta/intervals: merge + snap",
      "import": {
        "dist/intervals.js": "{ mergeWith, snapWith }"
      },
      "limit": "5 kB"
    },
    {
      "name": "minuta/format",
      "path": "dist/format.js",
      "import": "*",
      "limit": "5 kB"
    },
    {
      "name": "minuta/temporal: temporalReady",
      "path": "dist/temporal.js",
      "import": "{ temporalReady }",
      "limit": "5 kB"
    }
  ],
  "devDependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@minuta/tsconfig": "2.0.0-alpha.1",
    "@size-limit/esbuild": "^14.0.0",
    "@size-limit/file": "^14.0.0",
    "@types/node": "^22.12.1",
    "@vitest/coverage-v8": "^4.0.13",
    "size-limit": "^14.0.0",
    "typescript": "^5.7.3",
    "vite": "^7.2.4",
    "vite-plugin-dts": "^4.4.0",
    "vitest": "^4.0.13"
  },
  "peerDependencies": {
    "@js-temporal/polyfill": "^0.5.1"
  },
  "peerDependenciesMeta": {
    "@js-temporal/polyfill": {
      "optional": true
    }
  },
  "keywords": [
    "time",
    "date",
    "temporal",
    "divide",
    "typescript",
    "calendar",
    "stableMonth",
    "pure-functions",
    "framework-agnostic"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
