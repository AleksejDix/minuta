{
  "name": "minuta",
  "version": "1.0.0-beta.1",
  "type": "module",
  "description": "Divide time into pieces. Pure functional calendar library with a 4-method adapter contract.",
  "license": "Apache-2.0",
  "author": "Aleksej Dix <git@aleksejdix.com>",
  "homepage": "https://github.com/AleksejDix/minuta",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AleksejDix/minuta.git",
    "directory": "packages/minuta"
  },
  "bugs": {
    "url": "https://github.com/AleksejDix/minuta/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./calendar": {
      "types": "./dist/calendar.d.ts",
      "import": "./dist/calendar.js"
    },
    "./format": {
      "types": "./dist/format.d.ts",
      "import": "./dist/format.js"
    },
    "./types": {
      "types": "./dist/types.d.ts"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "import": "./dist/native.js"
    },
    "./temporal": {
      "types": "./dist/temporal.d.ts",
      "import": "./dist/temporal.js"
    },
    "./luxon": {
      "types": "./dist/luxon.d.ts",
      "import": "./dist/luxon.js"
    },
    "./dayjs": {
      "types": "./dist/dayjs.d.ts",
      "import": "./dist/dayjs.js"
    },
    "./date-fns": {
      "types": "./dist/date-fns.d.ts",
      "import": "./dist/date-fns.js"
    },
    "./date-fns-tz": {
      "types": "./dist/date-fns-tz.d.ts",
      "import": "./dist/date-fns-tz.js"
    },
    "./moment": {
      "types": "./dist/moment.d.ts",
      "import": "./dist/moment.js"
    }
  },
  "imports": {
    "#src/*": {
      "source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./src/*.ts"
    },
    "#readme": "./README.md"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "llms.txt"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "type-check": "tsc -p tsconfig.check.json",
    "clean": "rm -rf dist node_modules",
    "size": "size-limit",
    "docs:llms": "cd ../.. && UPDATE_LLMS=1 vitest run --project minuta src/__tests__/docs/llms.test.ts"
  },
  "size-limit": [
    {
      "name": "minuta: period + next + divide",
      "path": "dist/index.js",
      "import": "{ period, next, divide }",
      "limit": "3.2 kB"
    },
    {
      "name": "minuta: everything",
      "path": "dist/index.js",
      "import": "*",
      "limit": "3.5 kB"
    },
    {
      "name": "minuta/core: periodWith + nextWith with two units",
      "import": {
        "dist/core.js": "{ periodWith, nextWith }",
        "dist/native.js": "{ nativeUnits }"
      },
      "limit": "1.7 kB"
    },
    {
      "name": "minuta/calendar: monthGrid via bind",
      "import": {
        "dist/core.js": "{ bind }",
        "dist/calendar.js": "{ calendar }",
        "dist/native.js": "{ nativeUnits }"
      },
      "limit": "2.5 kB"
    },
    {
      "name": "minuta/format",
      "path": "dist/format.js",
      "import": "*",
      "limit": "1 kB"
    },
    {
      "name": "adapter: date-fns",
      "path": "dist/date-fns.js",
      "import": "{ dateFnsUnits }",
      "ignore": [
        "date-fns"
      ],
      "limit": "1 kB"
    },
    {
      "name": "adapter: date-fns-tz",
      "path": "dist/date-fns-tz.js",
      "import": "{ dateFnsTzUnits }",
      "ignore": [
        "date-fns",
        "date-fns-tz"
      ],
      "limit": "1.5 kB"
    },
    {
      "name": "adapter: dayjs",
      "path": "dist/dayjs.js",
      "import": "{ dayjsUnits }",
      "ignore": [
        "dayjs"
      ],
      "limit": "1 kB"
    },
    {
      "name": "adapter: luxon",
      "path": "dist/luxon.js",
      "import": "{ luxonUnits }",
      "ignore": [
        "luxon"
      ],
      "limit": "1 kB"
    },
    {
      "name": "adapter: moment",
      "path": "dist/moment.js",
      "import": "{ momentUnits }",
      "ignore": [
        "moment"
      ],
      "limit": "1 kB"
    },
    {
      "name": "adapter: temporal",
      "path": "dist/temporal.js",
      "import": "{ temporalUnits }",
      "ignore": [
        "@js-temporal/polyfill"
      ],
      "limit": "2 kB"
    }
  ],
  "devDependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@minuta/tsconfig": "2.0.0-alpha.1",
    "@size-limit/esbuild": "^14.0.0",
    "@size-limit/file": "^14.0.0",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.12.1",
    "@vitest/coverage-v8": "^4.0.13",
    "dayjs": "^1.11.20",
    "jsdom": "^26.0.0",
    "moment": "^2.30.1",
    "size-limit": "^14.0.0",
    "typescript": "^5.7.3",
    "vite": "^7.2.4",
    "vite-plugin-dts": "^4.4.0",
    "vitest": "^4.0.13"
  },
  "optionalDependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.0.0",
    "luxon": "^3.5.0"
  },
  "keywords": [
    "time",
    "date",
    "temporal",
    "divide",
    "typescript",
    "calendar",
    "stableMonth",
    "pure-functions",
    "framework-agnostic"
  ]
}
