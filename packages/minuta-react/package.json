{
  "name": "minuta-react",
  "version": "1.0.0-beta.1",
  "description": "React hooks for minuta",
  "author": "Aleksej Dix <git@aleksejdix.com>",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AleksejDix/minuta.git",
    "directory": "packages/minuta-react"
  },
  "bugs": {
    "url": "https://github.com/AleksejDix/minuta/issues"
  },
  "homepage": "https://github.com/AleksejDix/minuta",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./types": "./dist/types.d.ts"
  },
  "imports": {
    "#src/*": {
      "source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./src/*.ts"
    }
  },
  "types": "./dist/index.d.ts",
  "keywords": [
    "react",
    "hooks",
    "temporal",
    "time",
    "calendar"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite --mode demo",
    "demo:build": "vite build --mode demo",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc -p tsconfig.check.json && tsc -p examples/tsconfig.app.json",
    "clean": "rm -rf dist node_modules",
    "lint": "oxlint -c ../../.oxlintrc.json .",
    "lint:fix": "oxlint -c ../../.oxlintrc.json --fix .",
    "prepack": "node -e \"require('node:fs').copyFileSync('../../LICENSE', 'LICENSE')\""
  },
  "dependencies": {
    "minuta": "^1.0.0-beta.1"
  },
  "devDependencies": {
    "@minuta/tsconfig": "^2.0.0-alpha.1",
    "@testing-library/react": "^14.0.0",
    "@types/node": "^22.12.1",
    "@types/react": "^18.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "datefield": "^0.1.0",
    "input-dom": "^0.1.0",
    "input-state": "^0.1.0",
    "jsdom": "^25.0.1",
    "react": "^18.0.0",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.3",
    "vite": "^7.2.4",
    "vite-plugin-dts": "^4.4.0",
    "vitest": "^4.0.13"
  },
  "peerDependencies": {
    "react": "^18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
