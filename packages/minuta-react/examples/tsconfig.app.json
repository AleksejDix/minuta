{
  "extends": "@minuta/tsconfig/base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "types": ["vite/client"],
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "minuta-react": ["../src"],
      "minuta-react/components": ["../src/components/index"]
    },
    "declaration": false,
    "declarationMap": false,
    "isolatedDeclarations": false
  },
  "include": ["src"]
}
