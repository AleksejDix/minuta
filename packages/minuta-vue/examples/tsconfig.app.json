{
  "extends": "@minuta/tsconfig/base.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "paths": {
      "@/*": ["./src/*"],
      "@internationalized/date": [
        "../../../node_modules/@internationalized/date/dist/types/src/index.d.ts"
      ],
      "minuta-vue": ["../src/index"],
      "minuta-vue/components": ["../src/components/index"]
    },
    "declaration": false,
    "declarationMap": false,
    "isolatedDeclarations": false
  }
}
