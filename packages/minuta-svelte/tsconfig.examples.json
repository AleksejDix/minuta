{
  "extends": ["@tsconfig/svelte/tsconfig.json", "@minuta/tsconfig/base.json"],
  "compilerOptions": {
    "types": ["svelte"],
    "paths": {
      "minuta-svelte": ["./src"],
      "minuta-svelte/components": ["./src/components/index"]
    },
    "declaration": false,
    "declarationMap": false,
    "isolatedDeclarations": false
  },
  "include": [
    "examples/src/**/*.d.ts",
    "examples/src/**/*.ts",
    "examples/src/**/*.svelte"
  ],
  "exclude": ["examples/node_modules/**", "examples/dist/**"]
}
